{
  "meta": {
    "version": "3.0"
  },

  "server": {
    "port": 11590,
    "auth": {
      "mode": "local",
      "username": "admin",
      "password": "changeme"
    }
  },

  "database": {
    "provider": "sqlite"
  },

  "routing": {
    "chat": "models.gx10",
    "cli": "cli.gx10",
    "search": "search.duckduckgo"
  },

  "capabilities": {

    "models": {
      "enabled": true,
      "default": "gx10",
      "providers": {
        "gx10": {
          "enabled": true,
          "baseUrl": "http://localhost:8080/v1",
          "apiKey": "none",
          "model": "gx10-model"
        },
        "openrouter": {
          "enabled": true,
          "baseUrl": "https://openrouter.ai/api/v1",
          "apiKey": "YOUR_OPENROUTER_API_KEY",
          "model": "anthropic/claude-sonnet-4-5"
        }
      }
    },

    "search": {
      "enabled": true,
      "default": "duckduckgo",
      "providers": {
        "duckduckgo": { "enabled": true }
      }
    },

    "cli": {
      "enabled": true,
      "default": "gx10",
      "providers": {
        "gx10": { "enabled": true, "timeout": 300000 },
        "openrouter": { "enabled": true, "timeout": 300000 }
      }
    },

    "filesystem": {
      "enabled": true,
      "allowed_paths": [
        "~/Projects",
        "~/Documents",
        "/home/bigmints/Projects"
      ]
    },

    "google": { "enabled": false },
    "apple":  { "enabled": false },

    "mcp": {
      "enabled": true,
      "servers": {}
    },

    "scheduler": { "enabled": true },

    "channels": {
      "webchat":   { "enabled": true },
      "whatsapp":  { "enabled": false },
      "telegram":  { "enabled": false },
      "imessage":  { "enabled": false }
    }
  }
}
