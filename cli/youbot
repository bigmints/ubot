#!/usr/bin/env bash
# youbot — Personal AI Assistant CLI
# Usage: youbot <command>
set -Eeuo pipefail
umask 077

# Ensure nvm-managed node is in PATH
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" 2>/dev/null || true

VERSION="1.0.0"
LOGO="🤖"

# ─── Paths ──────────────────────────────────────────────────────────────────────
YOUBOT_HOME="${YOUBOT_HOME:-$HOME/.youbot}"
YOUBOT_APP_HOME="${YOUBOT_APP_HOME:-$YOUBOT_HOME}"
YOUBOT_CONFIG="$YOUBOT_HOME/config.json"
YOUBOT_LIB="$YOUBOT_APP_HOME/lib"
YOUBOT_WEB="$YOUBOT_APP_HOME/web"
YOUBOT_DATA="$YOUBOT_HOME/data"
YOUBOT_LOGS="$YOUBOT_HOME/logs"
YOUBOT_PIDFILE="$YOUBOT_HOME/youbot.pid"

# ─── Helpers ────────────────────────────────────────────────────────────────────
die()  { echo "❌ $*" >&2; exit 1; }
info() { echo "$LOGO $*"; }

# Read a value from config.json (requires node)
config_get() {
  node -e '
    const fs = require("fs");
    try {
      const c = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const keys = process.argv[2].split(".");
      let v = c;
      for (const k of keys) { v = v?.[k]; }
      if (v !== undefined) process.stdout.write(String(v));
    } catch {}
  ' "$YOUBOT_CONFIG" "$1" 2>/dev/null
}

ensure_home() {
  if [ ! -d "$YOUBOT_HOME" ]; then
    info "First run — creating $YOUBOT_HOME ..."
  fi
  install -d -m 700 "$YOUBOT_HOME" "$YOUBOT_DATA" "$YOUBOT_LOGS" \
    "$YOUBOT_HOME/sessions" "$YOUBOT_HOME/creds" "$YOUBOT_HOME/browser-profile" \
    "$YOUBOT_HOME/backups"

  if [ ! -f "$YOUBOT_CONFIG" ]; then
    # Copy default config if we have one bundled.
    local default_config
    default_config="$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")/default-config.json"
    if [ ! -f "$default_config" ]; then
      default_config="$YOUBOT_HOME/default-config.json"
    fi
    if [ -f "$default_config" ]; then
      install -m 600 "$default_config" "$YOUBOT_CONFIG"
      info "Created default config at $YOUBOT_CONFIG"
    fi
  else
    chmod 600 "$YOUBOT_CONFIG"
  fi
}

is_running() {
  [ -f "$YOUBOT_PIDFILE" ] || return 1
  local pid command_line
  pid="$(cat "$YOUBOT_PIDFILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ "$command_line" == *"$YOUBOT_LIB/index.js"* ]]
}

# ─── Commands ───────────────────────────────────────────────────────────────────

cmd_start() {
  ensure_home

  command -v node >/dev/null 2>&1 || die "Node.js is required"
  command -v curl >/dev/null 2>&1 || die "curl is required"
  command -v lsof >/dev/null 2>&1 || die "lsof is required"
  command -v ps >/dev/null 2>&1 || die "ps is required"

  if is_running; then
    local pid
    pid=$(cat "$YOUBOT_PIDFILE")
    info "Youbot is already running (PID $pid)"
    local port
    port=$(config_get server.port)
    port=${port:-11490}
    info "Dashboard: http://localhost:$port"
    exit 0
  fi

  if [ -f "$YOUBOT_PIDFILE" ]; then
    local stale_pid
    stale_pid="$(cat "$YOUBOT_PIDFILE")"
    if [[ "$stale_pid" =~ ^[0-9]+$ ]] && kill -0 "$stale_pid" 2>/dev/null; then
      die "PID file points to a process not owned by this Youbot installation; refusing to continue"
    fi
    rm -f "$YOUBOT_PIDFILE"
  fi

  # Verify installation
  [ -f "$YOUBOT_LIB/index.js" ] || die "Youbot is not installed. Run 'make install' from the source directory first."

  # Read config values for environment
  local port
  port=$(config_get server.port)
  port=${port:-11490}

  if lsof -tiTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Port $port is already in use; refusing to stop an unrelated process"
  fi

  local llm_base_url llm_model llm_api_key google_api_key db_path serper_api_key
  llm_base_url=$(config_get llm.base_url)
  llm_model=$(config_get llm.model)
  llm_api_key=$(config_get llm.api_key)
  google_api_key=$(config_get llm.google_api_key)
  serper_api_key=$(config_get integrations.serper_api_key)
  db_path="$YOUBOT_DATA/youbot.db"

  info "Starting Youbot on port $port ..."

  install -m 600 /dev/null "$YOUBOT_LOGS/youbot.log"

  # Export env vars that the backend reads
  PORT="$port" \
  NODE_ENV=production \
  DATABASE_PATH="$db_path" \
  LLM_BASE_URL="${llm_base_url}" \
  LLM_MODEL="${llm_model}" \
  LLM_API_KEY="${llm_api_key}" \
  GOOGLE_API_KEY="${google_api_key}" \
  SERPER_API_KEY="${serper_api_key}" \
  YOUBOT_HOME="$YOUBOT_HOME" \
  nohup node "$YOUBOT_LIB/index.js" \
    > "$YOUBOT_LOGS/youbot.log" 2>&1 &

  echo $! > "$YOUBOT_PIDFILE"

  local started_pid
  started_pid="$(cat "$YOUBOT_PIDFILE")"
  for _ in $(seq 1 30); do
    if curl --silent --fail --max-time 2 "http://127.0.0.1:$port/health" >/dev/null; then
      info "Youbot is ready! (PID $started_pid)"
      info "Dashboard: http://localhost:$port"
      info "Logs:      youbot logs"
      return
    fi
    kill -0 "$started_pid" 2>/dev/null || break
    sleep 1
  done
  kill "$started_pid" 2>/dev/null || true
  rm -f "$YOUBOT_PIDFILE"
  die "Youbot failed its readiness check. Check: youbot logs"
}

cmd_stop() {
  if [ ! -f "$YOUBOT_PIDFILE" ]; then
    info "Youbot is not running."
    return
  fi

  local pid
  pid=$(cat "$YOUBOT_PIDFILE")
  if ! [[ "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$YOUBOT_PIDFILE"
    info "Removed a stale PID file."
    return
  fi
  if ! is_running; then
    die "PID file points to a process not owned by this Youbot installation; refusing to stop it"
  fi
  info "Stopping Youbot (PID $pid) ..."
  kill "$pid" 2>/dev/null || true

  # Wait up to 5 seconds for graceful shutdown
  for i in $(seq 1 10); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done

  # Force kill if still running
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true

  rm -f "$YOUBOT_PIDFILE"
  info "Youbot stopped."
}

cmd_restart() {
  info "Restarting Youbot ..."
  cmd_stop
  sleep 1
  cmd_start
}

cmd_config() {
  local subcmd="${1:-}"
  case "$subcmd" in
    "")
      # Show current config
      if [ -f "$YOUBOT_CONFIG" ]; then
        node -e '
          const fs = require("fs");
          const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
          const sensitive = /(password|secret|token|api.?key|private.?key|service.?key|client_secret|connection_token)/i;
          function redact(input, path = "") {
            if (Array.isArray(input)) return input.map((item, index) => redact(item, `${path}.${index}`));
            if (!input || typeof input !== "object") return input;
            return Object.fromEntries(Object.entries(input).map(([key, child]) => {
              const childPath = path ? `${path}.${key}` : key;
              const isApiKeyValue = key === "key" && /(^|\.)api\.keys\.\d+$/.test(path);
              return [key, sensitive.test(key) || isApiKeyValue ? "[redacted]" : redact(child, childPath)];
            }));
          }
          process.stdout.write(`${JSON.stringify(redact(value), null, 2)}\n`);
        ' "$YOUBOT_CONFIG"
      else
        die "No config file found at $YOUBOT_CONFIG"
      fi
      ;;
    edit)
      # Open config in editor
      local editor="${EDITOR:-${VISUAL:-nano}}"
      if [ ! -f "$YOUBOT_CONFIG" ]; then
        ensure_home
      fi
      info "Opening config in $editor ..."
      "$editor" "$YOUBOT_CONFIG"
      ;;
    set)
      # Set a config value: youbot config set <key> <value>
      local key="${2:-}"
      local val="${3:-}"
      [ -z "$key" ] && die "Usage: youbot config set <key> <value>"
      [ -z "$val" ] && die "Usage: youbot config set <key> <value>"
      if [ ! -f "$YOUBOT_CONFIG" ]; then
        ensure_home
      fi
      node -e '
        const fs = require("fs");
        const path = process.argv[1];
        const c = JSON.parse(fs.readFileSync(path, "utf8"));
        const keys = process.argv[2].split(".");
        let obj = c;
        for (let i = 0; i < keys.length - 1; i++) {
          if (obj[keys[i]] === undefined) obj[keys[i]] = {};
          obj = obj[keys[i]];
        }
        let v = process.argv[3];
        if (v === "true") v = true;
        else if (v === "false") v = false;
        else if (!Number.isNaN(Number(v)) && v !== "") v = Number(v);
        obj[keys[keys.length - 1]] = v;
        const temporary = `${path}.${process.pid}.tmp`;
        fs.writeFileSync(temporary, `${JSON.stringify(c, null, 4)}\n`, { mode: 0o600 });
        fs.renameSync(temporary, path);
        fs.chmodSync(path, 0o600);
      ' "$YOUBOT_CONFIG" "$key" "$val" 2>/dev/null || die "Failed to update config"
      info "Updated $key"
      ;;
    get)
      # Get a config value: youbot config get <key>
      local key="${2:-}"
      [ -z "$key" ] && die "Usage: youbot config get <key>"
      local val
      val=$(config_get "$key")
      if [ -n "$val" ]; then
        echo "$val"
      else
        die "Key '$key' not found in config"
      fi
      ;;
    path)
      echo "$YOUBOT_CONFIG"
      ;;
    *)
      echo "Unknown config subcommand: $subcmd"
      echo "Usage: youbot config [edit|set|get|path]"
      exit 1
      ;;
  esac
}

cmd_doctor() {
  local ok=true
  echo "$LOGO Youbot Doctor"
  echo ""

  # Check Node.js
  if command -v node &>/dev/null; then
    local node_ver
    node_ver=$(node --version 2>/dev/null)
    local major
    major=$(echo "$node_ver" | sed 's/v//' | cut -d. -f1)
    if [ "$major" -ge 22 ] 2>/dev/null; then
      echo "  ✅ Node.js $node_ver (>= 22)"
    else
      echo "  ⚠️  Node.js $node_ver (requires >= 22)"
      ok=false
    fi
  else
    echo "  ❌ Node.js not found"
    ok=false
  fi

  # Check installation
  if [ -f "$YOUBOT_LIB/index.js" ]; then
    echo "  ✅ Backend installed at $YOUBOT_LIB/"
  else
    echo "  ❌ Backend not installed (run 'make install')"
    ok=false
  fi

  # Check config
  if [ -f "$YOUBOT_CONFIG" ]; then
    if node -e 'JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))' "$YOUBOT_CONFIG" 2>/dev/null; then
      echo "  ✅ Config valid at $YOUBOT_CONFIG"
    else
      echo "  ❌ Config is invalid JSON: $YOUBOT_CONFIG"
      ok=false
    fi
  else
    echo "  ⚠️  No config file (will be created on first start)"
  fi

  # Check port availability
  local port
  port=$(config_get server.port 2>/dev/null)
  port=${port:-11490}
  if is_running; then
    echo "  ✅ Youbot is running on port $port (PID $(cat "$YOUBOT_PIDFILE"))"
  else
    if lsof -i:"$port" &>/dev/null; then
      echo "  ⚠️  Port $port is in use by another process"
    else
      echo "  ✅ Port $port is available"
    fi
  fi

  # Check data directory
  if [ -d "$YOUBOT_DATA" ]; then
    local db_size=""
    if [ -f "$YOUBOT_DATA/youbot.db" ]; then
      db_size=" ($(du -sh "$YOUBOT_DATA/youbot.db" 2>/dev/null | cut -f1 | xargs))"
    fi
    echo "  ✅ Data directory exists$db_size"
  else
    echo "  ⚠️  No data directory yet"
  fi

  echo ""
  if $ok; then
    echo "  All checks passed! 🎉"
  else
    echo "  Some checks failed. Fix the issues above."
  fi
}

cmd_open() {
  local port
  port=$(config_get server.port)
  port=${port:-11490}
  local url="http://localhost:$port"

  if ! is_running; then
    info "Youbot is not running. Start it first: youbot start"
    exit 1
  fi

  info "Opening $url ..."
  if command -v open &>/dev/null; then
    open "$url"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$url"
  else
    info "Open manually: $url"
  fi
}

cmd_status() {
  if is_running; then
    local pid port
    pid=$(cat "$YOUBOT_PIDFILE")
    port=$(config_get server.port)
    port=${port:-11490}
    info "Youbot is running"
    echo "  PID:       $pid"
    echo "  Port:      $port"
    echo "  Dashboard: http://localhost:$port"
    echo "  Home:      $YOUBOT_HOME"
    echo "  Logs:      $YOUBOT_LOGS/youbot.log"
  else
    info "Youbot is not running."
    [ -f "$YOUBOT_PIDFILE" ] && rm -f "$YOUBOT_PIDFILE"
  fi
}

cmd_logs() {
  local log_file="$YOUBOT_LOGS/youbot.log"
  if [ ! -f "$log_file" ]; then
    info "No log file found at $log_file"
    exit 0
  fi
  # Follow mode with -f flag, or just show last 50 lines
  if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--follow" ]; then
    tail -f "$log_file"
  else
    tail -50 "$log_file"
  fi
}

cmd_backup() {
  ensure_home
  local tool="$YOUBOT_LIB/ops/data-backup.js"
  [ -f "$tool" ] || die "Backup tool is not installed. Run 'make update' from the source directory."
  if [ -n "${1:-}" ]; then
    YOUBOT_HOME="$YOUBOT_HOME" node "$tool" backup --home "$YOUBOT_HOME" --to "$1"
  else
    YOUBOT_HOME="$YOUBOT_HOME" node "$tool" backup --home "$YOUBOT_HOME"
  fi
}

cmd_backup_verify() {
  local source="${1:-}"
  [ -n "$source" ] || die "Usage: youbot backup-verify <backup-directory>"
  local tool="$YOUBOT_LIB/ops/data-backup.js"
  [ -f "$tool" ] || die "Backup tool is not installed. Run 'make update' from the source directory."
  YOUBOT_HOME="$YOUBOT_HOME" node "$tool" verify --home "$YOUBOT_HOME" --from "$source"
}

cmd_restore() {
  local source="${1:-}"
  [ -n "$source" ] || die "Usage: youbot restore <backup-directory>"
  ensure_home
  local tool="$YOUBOT_LIB/ops/data-backup.js"
  [ -f "$tool" ] || die "Backup tool is not installed. Run 'make update' from the source directory."
  if [ -f "$YOUBOT_PIDFILE" ]; then
    local pid
    pid="$(cat "$YOUBOT_PIDFILE")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      die "Stop Youbot before restoring a backup"
    fi
    rm -f "$YOUBOT_PIDFILE"
  fi
  YOUBOT_HOME="$YOUBOT_HOME" node "$tool" restore --home "$YOUBOT_HOME" --from "$source"
}

cmd_version() {
  echo "$LOGO youbot v$VERSION"
  echo "  Home: $YOUBOT_HOME"
  echo "  Node: $(node --version 2>/dev/null || echo 'not found')"
}

cmd_help() {
  echo "$LOGO youbot — Personal AI Assistant v$VERSION"
  echo ""
  echo "Usage: youbot <command>"
  echo ""
  echo "Commands:"
  echo "  start                  Start Youbot (creates ~/.youbot on first run)"
  echo "  stop                   Stop Youbot"
  echo "  restart                Stop + start Youbot"
  echo "  status                 Show running status"
  echo "  logs [-f]              Show logs (use -f to follow)"
  echo "  backup [directory]     Create a verified private data backup"
  echo "  backup-verify <dir>    Verify every file in a backup"
  echo "  restore <dir>          Restore a verified backup (Youbot must be stopped)"
  echo "  config                 Show current config"
  echo "  config edit            Open config in \$EDITOR"
  echo "  config set <key> <val> Set a config value"
  echo "  config get <key>       Get a config value"
  echo "  config path            Show config file path"
  echo "  doctor                 Health check"
  echo "  open                   Open dashboard in browser"
  echo "  version                Show version info"
  echo ""
  echo "Environment:"
  echo "  YOUBOT_HOME   Override home directory (default: ~/.youbot)"
}

# ─── Main ───────────────────────────────────────────────────────────────────────
command="${1:-}"

case "$command" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    shift; cmd_logs "$@" ;;
  backup)  shift; cmd_backup "$@" ;;
  backup-verify) shift; cmd_backup_verify "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  config)  shift; cmd_config "$@" ;;
  doctor)  cmd_doctor ;;
  open)    cmd_open ;;
  version) cmd_version ;;
  help|--help|-h) cmd_help ;;
  "")      cmd_help; exit 1 ;;
  *)       echo "Unknown command: $command"; cmd_help; exit 1 ;;
esac
